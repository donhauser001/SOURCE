{
    "name": "source",
    "version": "0.1.0",
    "private": true,
    "description": "实体印刷色彩实操体系",
    "scripts": {
        "dev": "pnpm --filter @source/web dev",
        "dev:fresh": "./scripts/dev.sh --fresh",
        "start": "./scripts/dev.sh",
        "build": "pnpm --filter @source/web build",
        "build:cli": "pnpm --filter @source/cli build",
        "lint": "pnpm -r lint",
        "test": "pnpm -r test:run",
        "test:web": "pnpm --filter @source/web test:run",
        "test:cli": "pnpm --filter @source/cli test:run",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "db:push": "pnpm --filter @source/web db:push",
        "db:seed": "pnpm --filter @source/web db:seed",
        "db:studio": "pnpm --filter @source/web db:studio",
        "db:reset": "pnpm --filter @source/web db:reset",
        "docker:start": "./scripts/docker.sh start",
        "docker:stop": "./scripts/docker.sh stop",
        "docker:restart": "./scripts/docker.sh restart",
        "docker:rebuild": "./scripts/docker.sh rebuild",
        "docker:reset": "./scripts/docker.sh reset",
        "docker:clean": "./scripts/docker.sh clean",
        "docker:logs": "./scripts/docker.sh logs -f",
        "docker:status": "./scripts/docker.sh status",
        "docker:shell": "./scripts/docker.sh shell",
        "docker:backup": "./scripts/docker.sh backup",
        "cli": "node packages/cli/dist/index.js"
    },
    "devDependencies": {
        "prettier": "^3.2.5",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "turbo": "^2.0.0"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20.0.0"
    }
}